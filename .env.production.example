# Copy to .env.production on the host, restrict it to the service operator (chmod 600),
# and provide secret values through the host's protected environment/secret process.
# Do not commit the populated file or send it in logs.
PROPOSAL_APP_ENV=production
PROPOSAL_ENV_FILE=/etc/proposal-ingest/.env.production
PROPOSAL_LOCAL_AUTH_ENABLED=false
PROPOSAL_SECRET_KEY=REPLACE_WITH_RANDOM_VALUE_AT_LEAST_50_CHARACTERS
PROPOSAL_ALLOWED_HOSTS=proposals.example.org
CSRF_TRUSTED_ORIGINS=https://proposals.example.org
PUBLIC_HOST=proposals.example.org
PROPOSAL_TLS_DIR=/etc/proposal-ingest/tls
POSTGRES_DB=proposal_ingest
POSTGRES_USER=proposal_ingest
# Generate a URL-safe secret (for example: openssl rand -hex 32).
POSTGRES_PASSWORD=REPLACE_WITH_URL_SAFE_RANDOM_SECRET
OIDC_ISSUER=https://login.microsoftonline.com/REPLACE_WITH_TENANT_ID/v2.0
ENTRA_CLIENT_ID=REPLACE_WITH_WEB_APP_CLIENT_ID
ENTRA_CLIENT_SECRET=REPLACE_WITH_WEB_APP_CLIENT_SECRET
ENTRA_REDIRECT_URI=https://proposals.example.org/auth/callback/
ENTRA_TENANT_ID=REPLACE_WITH_TENANT_ID
SHAREPOINT_CLIENT_ID=REPLACE_WITH_READ_ONLY_GRAPH_APP_CLIENT_ID
SHAREPOINT_SITE_ID=REPLACE_WITH_SITE_ID
SHAREPOINT_DRIVE_ID=REPLACE_WITH_DOCUMENT_LIBRARY_DRIVE_ID
SHAREPOINT_CLIENT_SECRET=REPLACE_WITH_SSM_VALUE

# Compose overrides DATABASE_URL with these same-host TLS settings at runtime.
DATABASE_URL=postgresql://proposal_ingest:REPLACE_WITH_URL_SAFE_RANDOM_SECRET@database:5432/proposal_ingest?sslmode=verify-full&sslrootcert=%2Frun%2Fpostgres-ca%2Fca.crt
PROPOSAL_STORAGE_BACKEND=local
MOCK_BEDROCK=false
JOB_WORKER_CONCURRENCY=1
JOB_MAX_RETRIES=3
AWS_REGION=us-east-1
PROPOSAL_PUBLICATION_BACKEND=managed_kb
PROPOSAL_LOCAL_STORAGE_ROOT=/var/lib/proposal-ingest/objects
PROPOSAL_LIVE_CLASSIFICATION_ENABLED=false
PROPOSAL_LIVE_DRAFTING_ENABLED=false
PROPOSAL_PUBLICATION_HOLD=true
PROPOSAL_DRAFTING_BACKEND=local
BEDROCK_CLASSIFICATION_MODEL_ID=
BEDROCK_CLASSIFICATION_ESTIMATE_USD_PER_CALL=
BEDROCK_DRAFTING_MODEL_ID=
PROPOSAL_DRAFTING_RESERVATION_USD=

# Managed KB curated destination. Runtime permissions should come from the instance role.
PROPOSAL_CURATED_BUCKET=REPLACE_WITH_PRIVATE_BUCKET_NAME
BEDROCK_KNOWLEDGE_BASE_ID=
BEDROCK_DATA_SOURCE_ID=

# Cost controls: configure values only after checking the approved envelope and account pricing.
SETUP_COST_LIMIT_USD=500
MONTHLY_VARIABLE_COST_LIMIT_USD=50
SINGLE_JOB_COST_LIMIT_USD=5
JOB_LEASE_SECONDS=120
JOB_MAX_ATTEMPTS=3
JOB_POLL_SECONDS=5
TRANSIENT_RESPONSE_RETENTION_DAYS=7
FAILED_JOB_RETENTION_DAYS=30
AUDIT_RETENTION_DAYS=365
