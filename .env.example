# Application mode. Deployed settings must never use local authentication.
PROPOSAL_APP_ENV=local
PROPOSAL_LOCAL_AUTH_ENABLED=true

# PostgreSQL (the checked-in value is for the disposable loopback-only container)
DATABASE_URL=postgresql://proposal_ingest:local-development-only@127.0.0.1:54329/proposal_ingest_dev

# Local/object storage
PROPOSAL_STORAGE_BACKEND=local
PROPOSAL_LOCAL_STORAGE_ROOT=tmp/app_storage
PROPOSAL_S3_BUCKET=
PROPOSAL_S3_PREFIX=

# Microsoft Entra OIDC and read-only SharePoint connector (future MVP phases)
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URI=
SHAREPOINT_SITE_ID=
SHAREPOINT_DRIVE_ID=
SHAREPOINT_SEED_FOLDER_IDS=

# AWS / Bedrock
AWS_PROFILE=proposal-assistant
AWS_REGION=us-east-1
BEDROCK_MODEL_LABEL=opus-4.6
BEDROCK_MODEL_ID=us.anthropic.claude-opus-4-6-v1
BEDROCK_CLASSIFICATION_MODEL_ID=
BEDROCK_DRAFTING_MODEL_ID=
BEDROCK_KNOWLEDGE_BASE_ID=

# Optional comparison provider; keep disabled until terms and access are approved
TYPESAFE_ENABLED=false
TYPESAFE_API_KEY=

# Local paths — set these for your machine; never commit real paths
PROPOSAL_INGEST_SOURCE_ROOT=
PROPOSAL_INGEST_OUTPUT_ROOT=
PROPOSAL_INGEST_TRACKER_PATH=

# Runtime behavior
MAX_DIRECT_UPLOAD_MB=20
SAVE_RAW_MODEL_RESPONSES=false
MOCK_BEDROCK=false
LOG_LEVEL=INFO

# Durable-job, spending, and retention defaults for later application phases
JOB_WORKER_CONCURRENCY=1
JOB_LEASE_SECONDS=120
JOB_MAX_RETRIES=3
MONTHLY_VARIABLE_COST_LIMIT_USD=50
SINGLE_JOB_COST_LIMIT_USD=5
TRANSIENT_RESPONSE_RETENTION_DAYS=7
FAILED_JOB_RETENTION_DAYS=30
AUDIT_RETENTION_DAYS=365

# Browser binaries default to ~/.codex/proposal-ingest/playwright when omitted
PLAYWRIGHT_BROWSERS_PATH=
